# notify worker base URL. The script posts JSON to ${NOTIFY_WORKER_URL}/post.
NOTIFY_WORKER_URL=https://your-notify-worker.example

NOTIFY_SIGN_KEY=your-notify-sign-key

# Cloudflare account containing the D1 database.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# D1 database ID, not the database name.
NOTIFY_D1_DATABASE_ID=your-notify-d1-database-id
BARK_D1_DATABASE_ID=your-bark-d1-database-id

# API token needs Account > D1 > Edit permission.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Contact URI used in Web Push VAPID authentication.
WEB_PUSH_VAPID_SUBJECT=mailto:mailto:admin@example.com
